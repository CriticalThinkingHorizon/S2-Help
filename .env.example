PORT=8080
NODE_ENV=development

TLS_ENABLED=false
TLS_KEY_PATH=/etc/letsencrypt/live/general/privkey.pem
TLS_CERT_PATH=/etc/letsencrypt/live/general/fullchain.pem

DATA_DIR=./data

# Poll analytics (MySQL)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Set to true when the MySQL server requires TLS
DB_SSL=false
# Optional PEM certificate authority
DB_SSL_CA=

# Poll security
POLL_SESSION_SECRET=
BRICK_WALL_HASH_SECRET=
# Set to 1 when running behind one proxy hop (for example Wasmer)
TRUST_PROXY=0
